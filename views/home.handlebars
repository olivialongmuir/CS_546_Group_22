<section id="homeSection">
    <H1 id="homeHeader">Welcome to SqueakPeek</H1>

    <p id="homepageDesc">
        Find restaurants, rodent hotspots, and real user reports all in one place.
        Make data-driven dining decisions with comprehensive rodent sighting data, health inspector reports, and community feedback from across New York City.
    </p>

    <p class="homeP">
        Begin browsing today!
    </p>

    <div id="homeButtons">
        <a class="pillButton" href="/heatmap">Explore Heatmap </a>
        <a class="pillButton" href="/restaurants">Browse Restaurants</a>
    </div>

    <section>
        <h2 class="homeH2">Analytics</h2>
        <p class="homeP">Real time data from NYC</p>

        <div class="card-row">
            <div class="card">
                <i data-lucide="utensils-crossed"class="home-icon"></i>
                <h3>Total Restaurants</h3>
                <p id="homeTotalRestaurants">{{ homeTotalRestaurants }}</p>
            </div>
            <div class="card">
                <i data-lucide="triangle-alert"class="home-icon"></i>
                <h3>Total Reports</h3>
                <p id="homeTotalReports">{{ homeTotalReports }}</p>
            </div>
            <div class="card">
                <i data-lucide="users-round"class="home-icon"></i>
                <h3>Total Users</h3>
                <p id="homeTotalUsers">{{ homeTotalUsers }}</p>
            </div>
            <div class="card">
                <i data-lucide="search-check"class="home-icon"></i>
                <h3>Verified Sightings</h3>
                <p id="homeVerifiedSightings">{{ homeVerifiedSightings }}</p>
            </div>
        </div>

    </section>

    <script type="module" src="/public/js/home.js"></script>

</section>
