<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<link rel="stylesheet" href="/public/css/rodentReport.css">

<link rel="stylesheet" href="/public/css/restaurants.css">


<section>
    <div class="container">
    <div class="leftPane">

        {{!-- Filter Panel --}}
        <h2>Browse Reports</h2>
        <div class="panel filterPanel">

            <div class="filters">
                <div class="filterItem">
                    <label class="filterLabel" for="startDate">Report Date</label>
                    <div class="dateRange">
                        <input id="startDate" type="date" name="startDate" aria-label="Start date">
                        <span class="dateRangeSeparator">to</span>
                        <input id="endDate" type="date" name="endDate" aria-label="End date">
                    </div>
                </div>

                <div class="filterItem">
                    <p class="filterLabel">Report Status:</p>
                    <span class="checkbox"><input type="checkbox" id="verifiedStatus" name="verifiedStatus">Verified Only</span>
                </div>
            </div>

            <div>
                <button type="button" class="btn btn--outline" id="clearFilters">Clear Filters</button>
            </div>
        </div>

        <!-- Cards list -->
        <ul class="rodent-list"></ul>
        {{#each reports}}
            <a href="/ratreports/{{this._id}}" class="rodent-card panel" data-id="{{this._id}}" status-id="{{this.status}}" data-timestamp="{{this.timestamp}}">
                <div class="rodent-card-main">
                    {{!-- <h3 class="rodent-name">{{this._id}}</h3> --}}
                        <div class="rodent-meta">
                            <span class="meta-item"><span class="meta-icon">📍</span>Location: {{this.latitude}} {{this.longitude}}</span>
                            {{!-- <span>{{this.status}}</span> --}}
                        </div>
                    <p class="restaurant-address">{{this.timestamp}}</p>
                </div>
                <div class="restaurant-card-side">
                    {{#if (eq this.status "verified")}}
                    <span class="status-badge verified">{{this.status}} 
                        <i data-lucide="shield-check"class="verified-icon"></i>
                    </span>
                    {{else}}
                    <span class="status-badge unverified">{{this.status}}</span>
                    {{/if}}
                </div>
            </a>
        {{/each}}
        </ul>
    </div>

    <div class="rightPane">
        <!-- render the individual rodent report page -->
        {{#if report}}
            {{> rodentReport}}
        {{else}}
            <p class="panel ratDetailPanel">No Rodent Reports Yet!</p>
        {{/if}}
    </div>
</section>

<script src="/js/rodentReports.js"></script>

<script src="/js/reactions.js"></script>

{{!-- leaflet scripts --}}
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

{{!-- leaflet heat plugin --}}
<script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>

