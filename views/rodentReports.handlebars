<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<link rel="stylesheet" href="/public/css/rodentReport.css">

<link rel="stylesheet" href="/public/css/restaurants.css">



<section>
    <div class="container">
    <div class="leftPane">


        {{!-- Filter Panel --}}
        <div class="filterPanel">
        <h2>Filter Reports</h2>
            <div class="filterBlock">
                    <div class="filterItem">
                    <p class="filterLabel">Report Date:</p>
                    <div class="dateRange">
                        <input id="startDate" type="date" name="startDate">
                        <input id="endDate" type="date" name="endDate">
                    </div>
                </div>

            <div class="filterItem checkboxItem">
                <span>
                    <p class="filterLabel">Verified Only:</p>
                    <input type="checkbox" id="verifiedStatus" name="verifiedStatus">
                </span>
            </div>

                <button type="button" class="btn btn--outline" id="clearFilters">
                Clear Filters
                </button>
            </div>
        </div>

        <!-- Cards list -->
        <ul class="rodent-list"></ul>
        {{#each reports}}

            {{!-- <div class="ratCard" data-id="{{this._id}}" status-id="{{this.status}}" data-timestamp="{{this.timestamp}}">
                <p>Report: {{this.jobId}}</p>
                <p>Time: {{this.timestamp}}</p>
                <p>Location: {{this.latitude}} {{this.longitude}}</p>
                <p>{{this.status}}</p>
            </div> --}}
                <div class="rodent-card panel" data-id="{{this._id}}" status-id="{{this.status}}" data-timestamp="{{this.timestamp}}">
                <div class="rodent-card-main">
                    {{!-- <h3 class="rodent-name">{{this._id}}</h3> --}}
                        <div class="rodent-meta">
                            <span class="meta-item"><span class="meta-icon">📍</span>Location: {{this.latitude}} {{this.longitude}}</span>
                            {{!-- <span>{{this.status}}</span> --}}
                        </div>
                    <p class="restaurant-address">{{this.timestamp}}</p>
                </div>
                  <div class="restaurant-card-side">
                    {{!-- <span class="status-badge status-badge--{{this.status.key}}">{{this.status.label}}</span> --}}
                      <span class="grade-pill">{{this.status}}</span>
                  </div>
                </div>
        {{/each}}
        </ul>
    </div>

    <div class="rightPane">
        <!-- this part will be edited by client side js -->
        <div id="ratReportDetail" class="panel ratDetailPanel">
            <div class="minimapPanel">
                <section id="miniHeatmapSection">
                    {{!-- map container --}}
                    <div id="miniHeatmap" class="miniHeatmap"></div>
                    <script>
                        {{!-- TODO - pass in rodent data --}}
                        const restaurantMapData = {{{restaurantMapData}}};
                    </script>
                </section>
            </div>

            {{#if firstReport}}

                {{!-- Info Section --}}
                <div class="infoRow">
                    <span id="zipcode" class="locationStat largeStat">Zipcode: {{firstReport.zipcode}}</span>
                    <span id="latitude" class="locationStat largeStat">Lat: {{firstReport.latitude}}</span>
                    <span id="longitude" class="locationStat largeStat">Lng: {{firstReport.longitude}}</span>
                    <span id="status" class="locationStat largeStat">Status: {{firstReport.status}}</span>
                </div>

                {{!-- Report Section --}}
                <div>
                    {{!-- <h2>Report {{firstReport._id}}</h2> --}}
                    <p>User: {{firstReport.userId}}</p>
                    <p>{{firstReport.timestamp}}</p>
                    <p>{{firstReport.description}}</p>
                </div>

                {{!-- Reactions Section --}}
                <button>LIKE THIS</button>
                <button>DISLIKE THIS</button>


                {{!-- Comment and Reaction Setting --}}
                <section class="detail-comments" aria-labelledby="comments-heading">
                    <div class="comments-header">
                    <span class="comments-icon">💬</span>
                    <h2 id="comments-heading">Comments</h2>
                    <span class="comments-count">({{comments.length}})</span>
                    </div>

                    {{#if isLoggedIn}}

                    {{#if error}}
                        <div class="error-banner">
                        {{error}}
                        </div>
                    {{/if}}

                    <button id="showCommentBtn" class="add-comment-btn">
                        + Add Comment
                    </button>

                    <section id="commentFormContainer" class="add-comment" style="display: none;">
                        <form method="POST" action="/restaurants/{{restaurant.id}}/comments">
                        
                        <textarea
                            id="commentTextarea"
                            name="comment"
                            rows="3"
                            placeholder="Write your comment..."
                            required>{{formData.comment}}
                        </textarea>

                        <div class="comment-actions">
                            <button type="submit">Post Comment</button>
                            <button type="button" id="cancelCommentBtn">Cancel</button>
                        </div>

                        </form>
                    </section>

                    {{else}}

                    <p class="login-prompt">
                        You must <a href="/login">log in</a> to add a comment or reaction.
                    </p>

                    {{/if}}

                    {{#if comments.length}}
                    <ul class="comment-list">
                        {{#each comments}}
                        <li class="comment-item">
                            <p class="comment-author">{{this.userName}}</p>
                            <p class="comment-text">{{this.comment}}</p>
                            <p class="comment-time">{{this.timestamp}}</p>
                            <div class="comment-actions">

                            <div class="vote-group">
                                <button
                                class="vote-btn"
                                data-id="{{this._id}}"
                                data-type="like"
                                {{#unless ../isLoggedIn}}disabled{{/unless}}
                                >
                                👍
                                </button>
                                <span class="vote-count" id="likes-{{this._id}}">
                                {{this.stats.likes}}
                                </span>
                            </div>

                            <div class="vote-group">
                                <button
                                class="vote-btn"
                                data-id="{{this._id}}"
                                data-type="dislike"
                                {{#unless ../isLoggedIn}}disabled{{/unless}}
                                >
                                👎
                                </button>
                                <span class="vote-count" id="dislikes-{{this._id}}">
                                {{this.stats.dislikes}}
                                </span>
                            </div>

                            {{#if (eq this.userId ../currentUserId)}}
                                <button 
                                class="delete-btn" 
                                data-id="{{this._id}}">
                                🗑 Delete
                                </button>
                            {{/if}}

                            </div>
                        </li>
                        {{/each}}
                    </ul>
                    {{else}}
                    <div class="empty-comments">
                        <p>No comments yet.</p>
                    </div>
                    {{/if}}
                </section>
                <script>
                    const showBtn = document.getElementById('showCommentBtn');
                    const formContainer = document.getElementById('commentFormContainer');
                    const cancelBtn = document.getElementById('cancelCommentBtn');
                    const textarea = document.getElementById('commentTextarea');

                    showBtn.addEventListener('click', () => {
                    formContainer.style.display = 'block';
                    showBtn.style.display = 'none';
                    textarea.focus();
                    });

                    cancelBtn.addEventListener('click', () => {
                    formContainer.style.display = 'none';
                    showBtn.style.display = 'inline-block';
                    textarea.value = '';
                    });
                </script>




            {{/if}}
            {{!-- Data for that report gets written into here when a card is clicked --}}
        </div>
    </div>
</section>


<script src="/js/rodentReports.js"></script>

{{!-- leaflet scripts --}}
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

{{!-- leaflet heat plugin --}}
<script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>



