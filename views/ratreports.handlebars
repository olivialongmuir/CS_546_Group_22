<section>
    <div class="container">
    <div class="leftPane">
        <!-- Cards list -->
        {{#each reports}}
            <div class="ratCard">
                <li>{{this._id}}</li>
                <li>{{this.latitude}}</li>
                <li>{{this.longitude}}</li>
                <li>{{this.timestamp}}</li>
            </div>
        {{/each}}
    </div>

    <div class="rightPane">
        <!-- this part will be edited by client side js -->
        <h2>Rodent Report</h2>
        <div id="ratReportDetail">
            edit the data here
        </div>
    </div>
    </div>
</section>

