{{!-- WRAPPED BY MAIN.HANDLEBARS --}}

<section id="adminSection">
    <nav class="admin-nav">
        <a class="pillButton" href="/admin">Pending Approvals</a>
        <a class="pillButton" href="/admin/restaurants">Manage Restaurants</a>
        <a class="pillButton" href="/admin/rodent-reports">Manage Rodent Reports</a>
    </nav>

    <div class="admin-edit">
        {{#if (eq mode "create")}}
            <h1>New Restaurant</h1>
        {{else}}
            <h1>Edit Restaurant</h1>
        {{/if}}

        {{#if errorMessage}}
            <p class="error">{{errorMessage}}</p>
        {{/if}}

        <form class="admin-form" method="POST" action="{{formAction}}">
            <div>
                <label for="name">Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    value="{{ restaurant.name }}"
                    required
                />
                <span class="tooltip">ⓘ
                    <span class="tooltip-text">Can only contain letters, numbers, spaces, and special characters _'&\-. Length must be between 1 and 100 characters.</span>
                </span>
            </div>

            <div>
                <label for="type">Type</label>
                <input
                    type="text"
                    id="type"
                    name="type"
                    value="{{ restaurant.type }}"
                    required
                />
                <span class="tooltip">ⓘ
                    <span class="tooltip-text">Can only contain letters, numbers, and underscores. Length must be between 1 and 100 characters.</span>
                </span>
            </div>

            <div>
                <label for="latitude">Latitude</label>
                <input
                    type="number"
                    step="any"
                    id="latitude"
                    name="latitude"
                    value="{{ restaurant.latitude }}"
                    required
                />
                <span class="tooltip">ⓘ
                    <span class="tooltip-text">Must be between 40.4774 and 40.9176.</span>
                </span>
            </div>

            <div>
                <label for="longitude">Longitude</label>
                <input
                    type="number"
                    step="any"
                    id="longitude"
                    name="longitude"
                    value="{{ restaurant.longitude }}"
                    required
                />
                <span class="tooltip">ⓘ
                    <span class="tooltip-text">Must be between -74.2591 and -73.7004.</span>
                </span>
            </div>

            <div>
                <label for="website">Website</label>
                <input
                    type="url"
                    id="website"
                    name="website"
                    value="{{ restaurant.website }}"
                    optional
                />
                <span class="tooltip">ⓘ
                    <span class="tooltip-text">Optional: Must be a standard URL. Prefixed with https://</span>
                </span>
            </div>

            <div>
                <label for="phone">Phone</label>
                <input
                    type="text"
                    id="phone"
                    name="phone"
                    value="{{ restaurant.phone }}"
                    optional
                />
                <span class="tooltip">ⓘ
                    <span class="tooltip-text">Optional: Must be exactly 10 numbers long. Each number can be 0 to 9.</span>
                </span>
            </div>

            <div>
                <label for="status">Status</label>
                <select id="status" name="status" required>
                    {{#each statuses}}
                        <option value="{{this}}" {{#if (eq this ../restaurant.status)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                </select>
            </div>

            <div class="formButtonRow">
                <a class="pillButton" href="/admin/restaurants">Cancel</a>
                <button type="submit" class="pillButton">
                    {{#if (eq mode "create")}}Create{{else}}Save{{/if}}
                </button>
            </div>
        </form>
    </div>
</section>