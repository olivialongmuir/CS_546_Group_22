<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />



<section id="heatmapSection">

    <h1 id="heatmapTitle">NYC Rodent Heatmap</h1>
    <p id="heatmapSubtitle">Interactive map showing rodent hotspots across New York City</p>

    <!-- Layout wrapper -->
    <div id="heatmapLayout">

        <!-- left - map and search bar -->
        <div id="mapColumn">

            <div id="searchBarContainer">
                <div id="autocompleteList"></div>
                <input id="searchInput" type="text" placeholder="Search Restaurants">
                <button class="btn" id="searchButton">Search</button>
                <button id="themeToggle">
                <span id="themeIcon">
                    <i data-lucide="moon"></i>
                </span>
                </button>
            </div>

            {{!-- Heatmap --}}
            <div id="heatmap">
                {{!-- Pop up partial for the rodent report form --}}
                {{> createReport}}
                {{!-- Pop up partial for the register restaurant form --}}
                {{> registerRestaurant}}
            </div>
        </div>

        <!-- right - hotspot feed -->
        <aside id="hotspotFeed">
            <h2>Hotspot Feed</h2>
            <ul id="hotspotList">
                {{#each hotspotFeed}}
                    <li>
                        <div class="hotspot-left">
                            <strong>{{this.neighborhood}}</strong>
                            <span class="borough">{{this.borough}}</span><br>
                            <span class="risk-badge risk-badge--{{this.riskKey}}">{{this.riskLabel}}</span>
                        </div>
                        <div class="hotspot-right">
                            <i data-lucide="trending-up"></i><span>{{this.count}} reports </span>
                        </div>
                    </li>
                {{/each}}
            </ul>
        </aside>


    </div>



    <script>
        const restaurantMapData = {{{jsonForScript restaurantMapData}}};
    </script>

    <script>
        const rodentMapData = {{{jsonForScript rodentMapData}}};
    </script>

    <script>
        const userAuthenticated = {{userAuthenticated}}
    </script>


    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>
    <script src="/public/js/heatmap.js"></script>

</section>