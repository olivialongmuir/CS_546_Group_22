<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />



<section id="heatmapSection">

    <h1 id="heatmapTitle">NYC Rodent Heatmap</h1>
    <p id="heatmapSubtitle">Interactive map showing rodent hotspots across New York City</p>

    <!-- Layout wrapper -->
    <div id="heatmapLayout">

        <!-- left - map and search bar -->
        <div id="mapColumn">

            <div id="searchBarContainer">
                <div id="autocompleteList"></div>
                <input id="searchInput" type="text" placeholder="Search Restaurants">
                <button id="searchButton">Search</button>
            </div>

            <div id="heatmap"></div>
        </div>

        <!-- right - hotspot feed -->
        <aside id="hotspotFeed">
            <h2>Hotspot Feed</h2>
            {{!-- TODO - populate list with hotspot data and better styling --}}
            <ul id="hotspotList">
                {{#each hotspotFeed}}
                    <li>
                        <strong>{{this.name}}</strong><br>
                        <span>{{this.status}}</span>
                    </li>
                {{/each}}
            </ul>
        </aside>

    </div>

    <script>
        const restaurantMapData = {{{restaurantMapData}}};
    </script>

    <script>
        const rodentMapData = {{{rodentMapData}}};
    </script>

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>
    <script src="/public/js/heatmap.js"></script>

</section>