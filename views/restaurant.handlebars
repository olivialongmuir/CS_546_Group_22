<link rel="stylesheet" href="/public/css/restaurants.css">

<div class="restaurant-detail-page">
  <div class="page-container">

    <div class="back-link">
      <a href="/restaurants">← Back to restaurants</a>
    </div>

    <article class="restaurant-detail panel">

      <header class="detail-header">
        <div>
          <h1 class="detail-name">{{restaurant.name}}</h1>
          <div class="detail-meta">
            <span class="meta-item"><span class="meta-icon">📍</span>{{restaurant.borough}}</span>
            <span class="meta-sep">•</span>
            <span>{{restaurant.cuisine}}</span>
          </div>
          {{#if restaurant.address}}
            <p class="restaurant-address">
              {{restaurant.address}}{{#if restaurant.zipcode}}, {{restaurant.zipcode}}{{/if}}
            </p>
          {{/if}}
        </div>
        <div class="restaurant-card-side">
          <span class="status-badge status-badge--lg status-badge--{{restaurant.status.key}}">
            {{restaurant.status.label}}
          </span>
          {{#if restaurant.grade}}
            <span class="grade-pill">Grade {{restaurant.grade}}</span>
          {{/if}}
        </div>
      </header>

      {{#if restaurant.phone}}
        <div class="detail-actions">
          <span class="meta-item"><span class="meta-icon">📞</span>{{restaurant.phone}}</span>
        </div>
      {{/if}}

      <div class="detail-stats">
        <div class="stat-tile">
          <div class="stat-tile-value">{{#if restaurant.grade}}{{restaurant.grade}}{{else}}—{{/if}}</div>
          <div class="stat-tile-label">Health Grade</div>
        </div>
        <div class="stat-tile">
          <div class="stat-tile-value">{{#if restaurant.rodentScore}}{{restaurant.rodentScore}}{{else}}—{{/if}}</div>
          <div class="stat-tile-label">Rodent Score</div>
        </div>
        <div class="stat-tile">
          <div class="stat-tile-value stat-tile-value--small">
            {{#if restaurant.lastVerified}}{{restaurant.lastVerified}}{{else}}Not verified{{/if}}
          </div>
          <div class="stat-tile-label">Last Verified</div>
        </div>
      </div>

      <section class="detail-comments" aria-labelledby="comments-heading">
        <div class="comments-header">
          <span class="comments-icon">💬</span>
          <h2 id="comments-heading">Comments</h2>
          <span class="comments-count">({{comments.length}})</span>
        </div>

        {{#if isLoggedIn}}

          {{#if error}}
            <div class="error-banner">
              {{error}}
            </div>
          {{/if}}

          <button id="showCommentBtn" class="add-comment-btn">
            + Add Comment
          </button>

          <section id="commentFormContainer" class="add-comment" style="display: none;">
            <form method="POST" action="/restaurants/{{restaurant.id}}/comments">
              
              <textarea
                id="commentTextarea"
                name="comment"
                rows="3"
                placeholder="Write your comment..."
                required>{{formData.comment}}
              </textarea>

              <div class="comment-actions">
                <button type="submit">Post Comment</button>
                <button type="button" id="cancelCommentBtn">Cancel</button>
              </div>

            </form>
          </section>

        {{else}}

          <p class="login-prompt">
            You must <a href="/login">log in</a> to add a comment or reaction.
          </p>

        {{/if}}

        {{#if comments.length}}
          <ul class="comment-list">
            {{#each comments}}
              <li class="comment-item">
                <p class="comment-author">{{this.userName}}</p>
                <p class="comment-text">{{this.comment}}</p>
                <p class="comment-time">{{this.timestamp}}</p>
                <div class="comment-actions">

                  <div class="vote-group">
                    <button
                      class="vote-btn"
                      data-id="{{this._id}}"
                      data-type="like"
                      {{#unless ../isLoggedIn}}disabled{{/unless}}
                    >
                      👍
                    </button>
                    <span class="vote-count" id="likes-{{this._id}}">
                      {{this.stats.likes}}
                    </span>
                  </div>

                  <div class="vote-group">
                    <button
                      class="vote-btn"
                      data-id="{{this._id}}"
                      data-type="dislike"
                      {{#unless ../isLoggedIn}}disabled{{/unless}}
                    >
                      👎
                    </button>
                    <span class="vote-count" id="dislikes-{{this._id}}">
                      {{this.stats.dislikes}}
                    </span>
                  </div>

                  {{#if (eq this.userId ../currentUserId)}}
                    <button 
                      class="delete-btn" 
                      data-id="{{this._id}}">
                      🗑 Delete
                    </button>
                  {{/if}}

                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <div class="empty-comments">
            <p>No comments yet.</p>
          </div>
        {{/if}}
      </section>

      <script>
        const showBtn = document.getElementById('showCommentBtn');
        const formContainer = document.getElementById('commentFormContainer');
        const cancelBtn = document.getElementById('cancelCommentBtn');
        const textarea = document.getElementById('commentTextarea');

        showBtn.addEventListener('click', () => {
          formContainer.style.display = 'block';
          showBtn.style.display = 'none';
          textarea.focus();
        });

        cancelBtn.addEventListener('click', () => {
          formContainer.style.display = 'none';
          showBtn.style.display = 'inline-block';
          textarea.value = '';
        });
      </script>

    </article>
  </div>
</div>
<script src="/public/js/reactions.js"></script>
