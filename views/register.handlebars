{{!-- THIS FILE WILL BE WRAPPED BY MAIN.HANDLEBARS --}}

<section class="register-page" id="registerSection">
    <h1>Create Account</h1>

    {{#if error}}
        <p class="registerError" style="color: #c0392b;">{{ error }}</p>
    {{/if}}

    <p class="register-response" id="registerResponse" name="registerResponse" display="hidden"></p>

    <form class="register-form" id="registerForm" name="registerForm" method="POST" action="/register">
        <div>
            <label for="firstName">First Name</label>
            <input
                type="text"
                id="firstName"
                name="firstName"
                value="{{ firstName }}"
                required
            />
            <span class="tooltip">ⓘ
                <span class="tooltip-text">Must be alphabetic and less than 50 characters long.</span>
            </span>
        </div>

        <div>
            <label for="lastName">Last Name</label>
            <input
                type="text"
                id="lastName"
                name="lastName"
                value="{{ lastName }}"
                required
            />
            <span class="tooltip">ⓘ
                <span class="tooltip-text">Must be alphabetic and less than 50 characters long.</span>
            </span>
        </div>

        <div>
            <label for="username">Username</label>
            <input
                type="text"
                id="username"
                name="username"
                value="{{ username }}"
                required
                minlength="3"
                maxlength="20"
                pattern="[A-Za-z0-9_]+"
                title="Letters, numbers, and underscores only"
            />
            <span class="tooltip">ⓘ
                <span class="tooltip-text">Can only contain letters, numbers, and underscores. Length must be between 3 and 20 characters.</span>
            </span>
        </div>

        <div>
            <label for="emailAddress">Email</label>
            <input
                type="email"
                id="emailAddress"
                name="emailAddress"
                value="{{ emailAddress }}"
                required
            />
            <span class="tooltip">ⓘ
                <span class="tooltip-text">Must be a standard email address and not over 100 characters long.</span>
            </span>
        </div>

        <div>
            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                name="password"
                required
                minlength="8"
                maxlength="16"
                title="8-16 characters, one uppercase letter, one number, one special character !@#$%^&*"
            />
            <span class="tooltip">ⓘ
                <span class="tooltip-text">Must contain at least 1 uppercase letter, 1 number, and 1 special character !@#$%^&*. Length must be between 8 and 16 characters long.</span>
            </span>
        </div>

        <div>
            <label for="confirmPassword">Confirm Password</label>
            <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                required
                minlength="8"
                maxlength="16"
            />
            <span class="tooltip">ⓘ
                <span class="tooltip-text">Must match password exactly.</span>
            </span>
        </div>

        <div>
            <label for="type">Account Type</label>
            <select id="type" name="type" required>
                {{#each typeOptions}}
                    <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        </div>

        <button id="submitButton" name="submitButton" type="submit" class="pillButton">Sign Up</button>
    </form>

    <p>Already have an account? <a href="/login">Log in</a></p>

    <script type="module" src="/public/js/register.js"></script>

</section>
